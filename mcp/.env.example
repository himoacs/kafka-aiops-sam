# Copy to mcp/.env (gitignored) and fill in. Only the three URL/broker lines are required.
# See docs/connect-kafka.md, docs/connect-metrics.md and docs/connect-logs.md for each backend.

# ---- Kafka (tuannvm/kafka-mcp-server) ---------------------------------------------------------------
# Bootstrap servers the MCP container can reach (from inside Docker; localhost means the container itself,
# use host.docker.internal for a Kafka on this machine).
KAFKA_BROKERS=broker1.example.com:9092,broker2.example.com:9092
# SASL: plain | scram-sha-256 | scram-sha-512 ; leave empty for PLAINTEXT / TLS-only clusters.
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USER=
KAFKA_SASL_PASSWORD=
# TLS to the brokers. Public CA (MSK, Confluent Cloud, ...): just set KAFKA_TLS_ENABLE=true.
KAFKA_TLS_ENABLE=false
# Private CA: put the PEM in mcp/certs/ (for example mcp/certs/ca.pem) and set the in-container path below.
# This REPLACES the container's trusted roots, so use a bundle if you also need public CAs.
KAFKA_CA_CERT_FILE=
# Development only. Never in production.
KAFKA_TLS_INSECURE_SKIP_VERIFY=false

# ---- Prometheus (pab1it0/prometheus-mcp-server) ------------------------------------------------------
PROMETHEUS_URL=http://host.docker.internal:9090
# Optional auth: basic OR bearer. Multi-tenant (Mimir/Cortex/Thanos): PROMETHEUS_ORG_ID.
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
PROMETHEUS_TOKEN=
PROMETHEUS_ORG_ID=

# ---- Loki (incu6us/loki-mcp-server) ------------------------------------------------------------------
LOKI_URL=http://host.docker.internal:3100
# Optional auth: basic OR bearer (mutually exclusive). Multi-tenant Loki: LOKI_TENANT_ID.
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_BEARER_TOKEN=
LOKI_TENANT_ID=
