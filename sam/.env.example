# OPTIONAL. Copy to sam/.env (gitignored) only if you need one of the items below. scripts/apply.sh loads it.

# Where SAM reaches the MCP servers. Defaults match mcp/docker-compose.yaml with SAM on the same machine.
# If SAM runs in a container or on another host, change these (docs/get-sam.md, "MCP URLs").
#KAFKA_MCP_URL=http://localhost:9201/mcp
#PROMETHEUS_MCP_URL=http://localhost:9202/mcp
#LOKI_MCP_URL=http://localhost:9203/mcp

# Only with --with-models: for a SAM that has NO LLM configured yet. This creates models named "general" and
# "planning", overwriting any existing models of those names. Skip it if your SAM already has a model.
#LLM_SERVICE_PROVIDER=custom
#LLM_SERVICE_ENDPOINT=https://your-llm-endpoint.example.com
#LLM_SERVICE_API_KEY=
#LLM_SERVICE_GENERAL_MODEL_NAME=
#LLM_SERVICE_PLANNING_MODEL_NAME=

# Only with --with-slack (docs/slack.md)
#SLACK_BOT_TOKEN=
#SLACK_APP_TOKEN=
